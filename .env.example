# SupportSafe environment variables (root .env)
# Copy this file to .env and fill in real values.

# --- MongoDB Atlas (required) ---
# Atlas -> Cluster -> Connect -> Drivers -> copy the URI
# URL-encode special characters in the password (e.g. @ -> %40)
MONGO_ENDPOINT=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
# Database name (collections: users, admin, complains2, doc_embedding)
MONGO_DB_NAME=SupportSafe

# --- Google Gemini (required) - https://aistudio.google.com/apikey ---
GEMINI_API_KEY=your_gemini_api_key

# --- Groq (required) - https://console.groq.com/keys ---
GROQ_API_TOKEN=your_groq_api_token

# --- Supabase Storage (required for image generation) ---
# Supabase -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co/rest/v1/
SUPABASE_KEY=your_supabase_secret_key
SUPABASE_STORAGE_BUCKET=generated-images

# --- Django backend (optional; only if you run backend_django) ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
FRONTEND_ORIGIN=http://localhost:3000

# --- Twitter/X (optional; only for the /send-message SOS endpoint) ---
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=
