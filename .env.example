# SupportSafe environment variables (root .env)
# Copy this file to .env and fill in real values.

# --- MongoDB Atlas (required) ---
# Atlas -> Cluster -> Connect -> Drivers -> copy the URI
# URL-encode special characters in the password (e.g. @ -> %40)
MONGO_ENDPOINT=
# Database name (collections: users, admin, complains2, doc_embedding)
MONGO_DB_NAME=

# --- Google Gemini (required) - https://aistudio.google.com/apikey ---
GEMINI_API_KEY=

# --- Groq (required) - https://console.groq.com/keys ---
GROQ_API_TOKEN=

# --- Supabase Storage (required for image generation) ---
# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=

# --- Django backend (optional; only if you run backend_django) ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
FRONTEND_ORIGIN=http://localhost:3000

# --- Twitter/X (optional; only for the /send-message SOS endpoint) ---
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=
